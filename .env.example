# ========================================================
# CampusOS (City University) - Environment Variables Guide
# ========================================================
# Only these 4-5 variables are used in this project:

# 1. Server Port (Default is 3000)
PORT=3000

# 2. Node Environment ('development' for local coding, 'production' for live deployment)
NODE_ENV=production

# 3. JWT Token Secret Key (Any random secret string)
JWT_SECRET=campusos-city-university-jwt-secret-key-2026

# 4. Google Gemini API Key (For AI Notice Synthesizer & Campus Assistant)
GEMINI_API_KEY=

# 5. Gmail SMTP Credentials (For Real 2FA OTP Email Delivery)
SMTP_USER=sahinfdr89@gmail.com
SMTP_PASS=mgroqsvvtdsugldz
